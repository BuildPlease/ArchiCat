{
  "name": "archicat",
  "version": "0.1.1",
  "description": "Modular mirroring (M²) for clean TypeScript architecture.",
  "keywords": [
    "architecture",
    "clean-architecture",
    "mirroring",
    "modular",
    "module-system"
  ],
  "homepage": "https://github.com/BuildPlease/ArchiCat#readme",
  "bugs": {
    "url": "https://github.com/BuildPlease/ArchiCat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/ArchiCat.git"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    }
  },
  "bin": {
    "archicat": "./bin/archicat.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "clean": "devkit run clean",
    "clean:deep": "devkit run clean-deep",
    "dep:check": "devkit run dep-check",
    "dep:update": "devkit run dep-update",
    "format": "devkit run format-fix && devkit run lint-fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "consola": "3.4.2",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@buildplease/devkit": "1.3.0",
    "@types/node": "26.4.1",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
